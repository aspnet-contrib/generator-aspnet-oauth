{
  "name": "generator-aspnet-oauth",
  "version": "10.0.0",
  "description": "Yeoman generator for OAuth Providers for ASP.NET Core",
  "license": "MIT",
  "type": "module",
  "main": "app/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspnet-contrib/generator-aspnet-oauth.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Jerrie Pelser",
    "email": "jerrie@jerriepelser.com",
    "url": "https://github.com/jerriep"
  },
  "scripts": {
    "format": "prettier --write **/*.js",
    "format-check": "prettier --check **/*.js",
    "test": "mocha",
    "all": "npm run format && npm test"
  },
  "files": [
    "generators"
  ],
  "keywords": [
    "yeoman-generator",
    "ASP.NET",
    "aspnet",
    "oauth"
  ],
  "dependencies": {
    "cross-fetch": "4.1.0",
    "query-string": "9.3.1",
    "yeoman-generator": "7.5.1",
    "yosay": "3.0.0"
  },
  "devDependencies": {
    "glob": "13.0.6",
    "mocha": "11.7.5",
    "prettier": "3.8.1",
    "yeoman-environment": "5.1.2",
    "yeoman-test": "11.2.0"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 100,
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
